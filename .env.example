# Copiá este archivo a `.env` y completá los valores. Todos los valores de acá son de ejemplo (falsos).
# Vite solo expone al navegador las variables que empiezan con VITE_: nunca pongas acá claves secretas.

# URL base del backend (nexa-backend), sin barra final. En local suele ser el puerto 4000.
# En Vercel: la URL pública del backend desplegado, por ejemplo https://nexa-api.example.com
VITE_API_URL="http://localhost:4000"

# DSN público de Sentry para reportar errores del navegador. Es opcional: si queda vacío,
# la app funciona igual y solo avisa por consola que Sentry no está configurado.
# Formato: https://<clave-publica>@<organizacion>.ingest.sentry.io/<id-proyecto>
VITE_SENTRY_DSN=

# Identificador del estudio (tenant) de este despliegue. Opcional; hoy solo se guarda en app.config.ts.
VITE_TENANT_SLUG="loren"

# Idioma y moneda para formatear fechas e importes. Opcionales: por defecto es-AR y ARS.
VITE_LOCALE="es-AR"
VITE_CURRENCY="ARS"
